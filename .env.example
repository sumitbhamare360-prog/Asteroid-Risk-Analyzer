# PostgreSQL Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=asteroid_db
DB_PASSWORD=your_db_password
DB_PORT=5432

# Express Server Configuration
PORT=5000

# NASA API Key
# Get a key from https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# JPL API Configuration
# Base URLs for JPL Horizons, Sentry, and SBDB APIs
JPL_HORIZONS_BASE_URL=https://ssd-api.jpl.nasa.gov/api/horizons
JPL_SENTRY_BASE_URL=https://ssd-api.jpl.nasa.gov/api/sentry
JPL_SBDB_BASE_URL=https://ssd-api.jpl.nasa.gov/api/sbdb

# Cache TTL (hours) for trajectory and impact risk data
TRAJECTORY_CACHE_TTL_HOURS=168
IMPACT_RISK_CACHE_TTL_HOURS=168
